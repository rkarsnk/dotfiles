{
  "title": "macSKK",
  "rules": [
    {
      "description": "macSKK for Terminals/IDEs",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": {
              "mandatory": [
                "left_control"
              ]
            }
          },
          "to": [
            {
              "key_code": "japanese_kana"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.googlecode\\.iterm2",
                "^com\\.apple\\.Terminal",
                "^com\\.mitchellh\\.ghostty",
                "^com\\.microsoft\\.VSCode",
                "^dev\\.zed\\.Zed"
              ]
            }
          ]
        }
      ]
    }
  ]
}
